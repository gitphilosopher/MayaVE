{
  "$schema_version": 1,
  "meta": {
    "description": "Single source of truth for Maya's intent definitions. brain/intent_engine.py loads this file for classification metadata; it must not hardcode intent names, descriptions, or keyword triggers. Keyword triggers are matched with \\b...\\b plus an inflection suffix (s|es|d|ed|ing) by the engine, in list order within a rule and rule order as declared in 'keyword_rules_order' below.",
    "valid_categories": [
      "datetime",
      "reminder",
      "web",
      "system",
      "media",
      "utility",
      "weather",
      "clipboard",
      "notepad",
      "action",
      "conversation",
      "fallback"
    ]
  },
  "keyword_rules_order": [
    "search_web",
    "open_website",
    "set_reminder",
    "system_info",
    "lock_screen",
    "pause_music",
    "next_track",
    "prev_track",
    "volume_up",
    "volume_down",
    "shutdown",
    "open_app",
    "screenshot",
    "restart",
    "play_music",
    "mute",
    "get_time",
    "get_date",
    "general_query",
    "greet",
    "farewell",
    "dismissal",
    "thanks"
  ],
