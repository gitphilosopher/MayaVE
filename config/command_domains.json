{
  "$schema_version": 1,
  "meta": {
    "description": "Normalized domain.operation view of datasets/intents.json for brain/router (hybrid semantic router). This file does NOT replace datasets/intents.json — it is a deliberate projection of a subset of it (only intents whose response_mode is 'skill' AND that are not already handled by a deterministic guard in brain/intent_engine.py). Conversational intents (smalltalk, identity, joke, motivate, opinion, followup, general_query, unknown) and guard-handled intents (dismissal, greet, farewell, thanks, help, perform_action) are intentionally excluded — they keep using their existing paths. If datasets/intents.json's keyword_rules_order, an intent id, or an intent's response_mode changes, this file must be reviewed for drift; brain/router/command_vector_store.py fingerprints this file (not datasets/intents.json) to decide when to reseed."
  },
  "domains": {
    "datetime": {
      "operations": {
        "time": {
          "legacy_intent": "get_time",
          "entities": {},
          "target_mode": "raw",
          "seeds": [
            "what time is it",
            "current time please",
            "do you know the time",
            "tell me the time",
            "what's the clock say"
          ]
        },
        "date": {
          "legacy_intent": "get_date",
          "entities": {},
          "target_mode": "raw",
          "seeds": [
            "what's today's date",
            "what day is it",
            "what's the date today",
            "what month is it"
          ]
        }
      }
    },
    "timer": {
